# /etc/default/telegraf (o /etc/systemd/system/telegraf.service.d/override.conf)
# Queste variabili vengono interpolate da Telegraf all'avvio dentro il suo .conf

# URL del broker MQTT del server centrale (in VPN o internet)
MQTT_SERVER=ssl://mqtt.example.com:8883

# Credenziali del gateway (create lato server con mosquitto_passwd)
MQTT_USERNAME=gw-1
MQTT_PASSWORD=lapassword-del-gateway

# Path al CA cert del server. Se usi Let's Encrypt pubblico puoi puntare
# alla CA di sistema (/etc/ssl/certs/ca-certificates.crt). Se usi CA
# self-signed devi copiare /mosquitto/certs/ca.crt dal server e metterlo qui.
MQTT_TLS_CA=/etc/telegraf/ca.crt
